	(text "BACKUP RTC (U404 VBAT): \n10 x CPH3225A\nC1 = 11 mF -> Ctot = 10 x 11 mF = 110 mF (-20%: 88 mF)\n\nV0 = 3.3 V - Vf BAT54 (0.15 V) = 3.15 V (peggiore 3.0 V)\n\nVmin = 2.3 V (VBAT min DS3231M)\n\nI = 2 uA tip / 3 uA max (+0.5 uA perdite stimate)\n\nt = Ctot x (V0 - Vmin) / I\nTipico:   0.110 F x 0.85 V / 2.1 uA = 12.4 h\nI max:    0.110 F x 0.85 V / 3.3 uA =  7.9 h\nPeggiore: 0.088 F x 0.70 V / 3.5 uA =  4.9 h \nCon 8 pz: 0.070 F x 0.70 V / 3.5 uA =  3.9 h \n\nCarica: R412 1k, Imax 3 mA, tau = 110 s (piena in circa 9 min)\n"
		(exclude_from_sim no)
		(at 344.678 120.396 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "db71dc0b-17c5-42eb-9e94-87617ffcf740")
	)
