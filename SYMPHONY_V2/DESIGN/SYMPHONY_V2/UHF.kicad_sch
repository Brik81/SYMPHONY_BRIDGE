	(text "Backup nel caso IC205 Blocchi\n\nMotivo: può succedere che in TX venga drenata troppa potenza e la tensione droppi\n		triggerando IC205 che spegne tutto, lo scopriamo solo sperimentalmente\n\nSoluzione: inserire R205 (DNP) che nel caso IC205 non funzioni saldare un 0402 \n			0R che permette di fare il powerup via MCU \n\nAttenzione: nel caso dissaldare R204 che bypassa IC205\n\n "
		(exclude_from_sim no)
		(at 133.858 150.114 0)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left)
		)
		(uuid "5535bf83-d477-4d9c-9872-acd6637021af")
	)
